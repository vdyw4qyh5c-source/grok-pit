# VPS deploy — one place for name, domain, port.
# Port 38471 is uncommon so it should not collide with Rails/Node apps already
# running on this server.

APP_NAME=sergeybondarenko
DOMAIN=sergeybondarenko.pro
PORT=38471
HOST=127.0.0.1
BRANCH=main
NITRO_PRESET=node-server
NODE22_HOME=/usr/local/lib/node-v22
